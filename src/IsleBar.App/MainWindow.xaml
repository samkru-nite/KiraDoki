<?xml version="1.0" encoding="utf-8"?>
<!--
  The big pill (220x32, the card on top) + the small pill (the circle; task icons come in E3), side by side inside the taskbar
  (TODO 7.1 / 7.9 D, 10-07). One window covers both and is clipped to the two pill shapes (PillRegion); it is ArcRoom (7) taller
  than the pills above and below, room for the swap animation (E4). No card → only the small pill shows.
-->
<Window
    x:Class="IsleBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Background is filled in code with the "real search box background" (ThemeColors.ForActualBackground).
      No corners/border are drawn — clipping the window to a pill (PillRegion) so the real search box
      border shows through gives a more natural edge.
    -->
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
    <!-- Big pill · gap · small pill. Code puts them in columns 0 and 2 (or swapped when the small pill sits left) and sets the
         gap to 0 while the big pill is hidden. Margin top = ArcRoom -->
    <Grid x:Name="PillRow" Height="32" Margin="0,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="GapColumn" Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
    <!-- The whole big pill (background and all content): when a new item appears, this group dips slightly and springs back. The outer Root is the taskbar color -->
    <Grid x:Name="PillBody" Width="220">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />   <!-- empty (⌄ was here; the layout is redone in E2) -->
            <ColumnDefinition Width="Auto" />   <!-- Claude spark / magnifier / status icon -->
            <ColumnDefinition Width="*" />      <!-- input box or island content -->
            <ColumnDefinition Width="Auto" />   <!-- hover buttons -->
        </Grid.ColumnDefinitions>

        <!-- The pill itself: background + thin border drawn directly with soft edges. The window is clipped flush to the pill shape, and outside that edge
             is the taskbar color (Root background) — the clip edge can't be anti-aliased and gets stair-steps, but on the taskbar color they're invisible.
             Previously the window was clipped inward so the real search box border showed through, but in dark mode the steps were visible and a white band remained outside the glow border (user feedback 09-30) -->
        <Border x:Name="PillSurface" Grid.ColumnSpan="4" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False" />

        <!-- Left icon. Glyphs are Segoe Fluent Icons (part of Windows; no third-party icon sets) -->
        <!-- Alert border (green/orange, turned on by IslandAnimator). When on, the pill is clipped with no margin (covering the real search box
             border too) and the border is drawn slightly past the clip edge — a faint outer line blended with the white background into a white line (user feedback 09-30). Clicks pass through -->
        <!-- Preference C1 (setting "glow border"): faint border + a 1px shine line brightest at top center — adds depth (PILLAR technique, 09-30 design) -->
        <Grid x:Name="GlassEdge" Grid.ColumnSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="GlassBorder" Margin="0" BorderThickness="1" CornerRadius="16" />
            <Rectangle x:Name="GlassShine" Height="1" Margin="70,0.5,70,0" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#8CFFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Border x:Name="GlowBackdrop" Grid.ColumnSpan="4" Margin="-1" BorderThickness="3" CornerRadius="17" IsHitTestVisible="False" Visibility="Collapsed" />
        <Border x:Name="GlowRing" Grid.ColumnSpan="4" Margin="0.5" BorderThickness="3" CornerRadius="15.5" IsHitTestVisible="False" />

        <!-- When typing ends, focus moves here (so no blinking caret is left in the input box). Invisible -->
        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" UseSystemFocusVisuals="False" />

        <Grid x:Name="LeadSlot" Grid.Column="1" Width="17" Height="17" Margin="4,0,9,0" VerticalAlignment="Center">
            <!-- Claude mode: spark extracted from claude.exe's official icon (ClaudeGlyph). If extraction fails, the glyph below -->
            <Image x:Name="ClaudeGlyphImage" Width="21" Height="21" Margin="-2,-2,-2,-2" Visibility="Collapsed" />
            <!-- Codex mode: the mark from the user's own Codex extension for VS Code/Cursor (CodexMark) — IsleBar ships no OpenAI logo.
                 Not installed → the Windows glyphs below -->
            <Image x:Name="CodexGlyph" Width="20" Height="20" Margin="-1.5,-1.5,-1.5,-1.5" Visibility="Collapsed" />
            <!-- Music: album art (only when the player provides it). Large (24) to fit the pill height — 17 was too small to look good (user feedback 09-30).
                 It's wider than the left column (17) and overflows to the left — ⌄ is hidden while an island shows, so it uses that space, with a gap before the title -->
            <Border x:Name="AlbumArt" Width="24" Height="24" Margin="-3.5,-3.5,-3.5,-3.5" CornerRadius="12" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <FontIcon
                x:Name="LeadIcon"
                FontFamily="Segoe Fluent Icons"
                FontSize="18"
                Width="23"
                Height="23"
                Margin="-3,-3,-3,-3"
                Glyph="&#xE721;"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <!-- Compressing: zipper teeth over the font's document outline (E8A5) — the font has no zip-file icon, and this keeps its
                 stroke and corners, matching the copy/unzip icons (user 10-04). Same box as LeadIcon (em 18 centred in 23 → origin 2.5);
                 teeth are the outline's stroke wide, left of the folded corner. Follows LeadIcon's colour and visibility; code sets Opacity 1 only for compress -->
            <Canvas
                x:Name="ZipTeeth"
                Width="23"
                Height="23"
                Margin="-3,-3,-3,-3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False"
                Visibility="{Binding ElementName=LeadIcon, Path=Visibility}">
                <Path
                    Fill="{Binding ElementName=LeadIcon, Path=Foreground}"
                    Data="M7.9,3.6 h1.2 v1.2 h-1.2 Z M9.1,4.8 h1.2 v1.2 h-1.2 Z M7.9,6 h1.2 v1.2 h-1.2 Z M9.1,7.2 h1.2 v1.2 h-1.2 Z M7.9,8.4 h1.2 v1.2 h-1.2 Z M9.1,9.6 h1.2 v1.2 h-1.2 Z M7.9,11.1 h2.4 v2.2 h-2.4 Z" />
            </Canvas>
        </Grid>

        <!-- Input box. Placeholder text is always English regardless of language (Placeholders) -->
        <TextBox
            x:Name="Entry"
            Grid.Column="2"
            VerticalAlignment="Center"
            BorderThickness="0"
            Background="Transparent"
            PlaceholderText="Ask Claude"
            TextWrapping="NoWrap"
            AcceptsReturn="False"
            IsSpellCheckEnabled="False"
            FontSize="14"
            CharacterSpacing="-11"
            MinHeight="0"
            VerticalContentAlignment="Center"
            Padding="0,0,0,1">
            <!-- Keep the pill background while typing: remove the white box, border and blue underline (like the native search box) -->
            <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </TextBox.Resources>
        </TextBox>

        <!--
          Island content. Shown instead of the input box when not typing.
          One line + a thin progress bar below. The name is truncated with "…" to fit the width (TextFit).
        -->
        <Grid x:Name="IslandContent" Grid.Column="2" Visibility="Collapsed">
            <!--
              Text lives in a canvas — scrolling a long track title left (like music apps) requires placing it wider than the slot
              and moving it, and a canvas doesn't clip children to the slot size. The visible part is clipped in code via Clip.
            -->
            <Canvas x:Name="MarqueeHost">
                <!-- Two copies of the same title side by side — after scrolling one copy width + gap, the second copy lands exactly on the first (seamless) -->
                <StackPanel x:Name="MarqueePanel" Orientation="Horizontal">
                    <!-- Letter spacing −11 (1/1000em): a common tracking value for size 14 — makes the text look solid and cohesive (09-30 design T1) -->
                    <TextBlock x:Name="IslandText" FontSize="14" CharacterSpacing="-11" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="None" TextWrapping="NoWrap" />
                    <!-- Timer digits: one per slot (fixed width + only changed digits roll, 09-30 design M4) -->
                    <StackPanel x:Name="ClockDigits" Orientation="Horizontal" Margin="7,0,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="IslandTextCopy" FontSize="14" CharacterSpacing="-11" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="None" TextWrapping="NoWrap"
                               Margin="40,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Canvas>
            <!-- While scrolling, softly cover both ends with the background color (code paints the color) -->
            <!-- Height is just the text line — covering the whole slot also hid the top and bottom of the green/orange border, making it look like a translucent window (user feedback 09-30) -->
            <Rectangle x:Name="FadeLeft" Width="10" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            <Rectangle x:Name="FadeRight" Width="18" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>

        <!--
          Progress bar: sits at the inner bottom of the pill. Width matches the progress fraction.
          Placed outside the island text area so it <b>stays visible while typing</b> (user feedback 09-29: keep the graph visible even while using the search box).
        -->
        <Border
            x:Name="ProgressLine"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Height="2"
            Width="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="0,0,0,3" />

        <!--
          Flowing bar (transfer with unknown size): a quarter-length piece slides across this track, animated by the compositor
          (moving it from the 250ms tick drew only 4 frames a second, so it stuttered). Code sets the track's margin, width and clip.
        -->
        <Grid
            x:Name="FlowTrack"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Height="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="0,0,0,3"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <Border x:Name="FlowPiece" HorizontalAlignment="Left" />
        </Grid>

        <!-- Right: on hover, the island's buttons (music ⏮⏸⏭ etc.). ⌄ moved to the far left (as in the Python version) -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
            <!-- Music playing: four dancing bars — at the far right as in the mockup (moved to the left icon spot if there's no album art). Purely decorative, unrelated to the audio,
                 and animated by the compositor, so CPU/memory cost is negligible -->
            <!-- 09-30 design G2: scale up/down from the center (bottom-anchored looked like "pumping"), fully rounded ends, album color -->
            <StackPanel x:Name="Equalizer" Orientation="Horizontal" Spacing="2" Height="14"
                        Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Rectangle x:Name="Eq0" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle x:Name="Eq1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle x:Name="Eq2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle x:Name="Eq3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" />
            </StackPanel>
            <!-- Timer: circular progress on the right (like the desktop mockup). Stroke width matches the bottom progress bar (2) — the stock ProgressRing
                 can't change thickness and looked different from the bar (user feedback 09-30). Gray background ring + an arc for progress (rounded caps) -->
            <Grid x:Name="TimerRing" Width="16" Height="16" Margin="0,0,4,0" Visibility="Collapsed">
                <Ellipse x:Name="TimerTrack" StrokeThickness="2" /><!-- The stroke is drawn inside the bounds: in a 16 box the stroke center is at radius 7 = same as the arc -->
                <Path x:Name="TimerArc" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>

            <!-- Tab hint: dim [Tab] + next mode icon, only while the input box is empty (09-30 design decision B) -->
            <StackPanel x:Name="TabHint" Orientation="Horizontal" Spacing="5" Opacity="0.6" VerticalAlignment="Center"
                        Margin="0,0,6,0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="TabKey" BorderThickness="1,1,1,1.8" CornerRadius="4" Padding="4,0,4,1" VerticalAlignment="Center">
                    <TextBlock x:Name="TabKeyText" Text="Tab" FontSize="10.5" FontWeight="SemiBold" CharacterSpacing="20" />
                </Border>
                <FontIcon x:Name="TabNextIcon" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                <Image x:Name="TabNextMark" Width="13" Height="13" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <!-- Mic/camera in use (orange dot) — same row as the other elements, with a margin before it -->
            <Ellipse x:Name="PrivacyDot" Width="6" Height="6" Margin="5,0,3,0" VerticalAlignment="Center" Visibility="Collapsed" />

        </StackPanel>
    </Grid>

    <!-- Small pill: for now only the circle (the entry: left click = type, right click = tools). Cell 24 with 4 either side;
         the hover background is a 24 circle (TODO 7.9 D) -->
    <Grid x:Name="SmallPill" Grid.Column="2" Height="32">
        <Border x:Name="SmallSurface" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False" />
        <Grid x:Name="BallCell" Width="24" Height="24" Margin="4,0,4,0" Background="Transparent">
            <Ellipse x:Name="BallHover" Width="24" Height="24" Opacity="0" IsHitTestVisible="False" />
            <!-- the mark at rest: an empty ring, 8.4 across, 1.2 thick -->
            <Ellipse x:Name="BallRing" Width="8.4" Height="8.4" StrokeThickness="1.2" IsHitTestVisible="False" />
        </Grid>
    </Grid>
    </Grid>

    </Grid>
</Window>
