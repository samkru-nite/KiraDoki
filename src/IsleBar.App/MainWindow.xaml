<?xml version="1.0" encoding="utf-8"?>
<!--
  The big pill (220x32, the card on top) + the small pill (the circle; task icons come in E3), side by side inside the taskbar
  (TODO 7.1 / 7.9 D, 10-07). One window covers both and is clipped to the two pill shapes (PillRegion); it is ArcRoom (7) taller
  than the pills above and below, room for the swap animation (E4). No card → only the small pill shows.
-->
<Window
    x:Class="IsleBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:IsleBar.App.IslandUi"
    mc:Ignorable="d">

    <!-- Root's background is the taskbar colour sampled beside the bar: the pills draw their round edges on it (the clip is rectangles) -->
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
    <!-- Ink probe (E2): rendered once off-screen behind the pills to measure where this font's glyphs really sit in the 20 line box -->
    <TextBlock x:Name="InkProbe" Text="晴工Cl" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,7,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" IsHitTestVisible="False" />
    <!-- Big pill · gap · small pill. Code puts them in columns 0 and 2 (or swapped when the small pill sits left) and sets the
         gap to 0 while the big pill is hidden. Margin top = ArcRoom -->
    <Grid x:Name="PillRow" Height="32" Margin="0,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="GapColumn" Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
    <!-- The whole big pill (background and all content): when a new item appears, this group dips slightly and springs back. The outer Root is the taskbar color.
         What it draws is a PillView (IslandUi/PillView.xaml, 10-09: the ⋯ list draws its cards with the same) -->
    <Grid x:Name="PillBody" Width="220">
        <ui:PillView x:Name="Big" />
    </Grid>

    <!-- Small pill (TODO 7.9 D): task icons + ⋯ │ circle (or circle │ ⋯ + task icons when it sits left — code swaps the columns).
         Task cells are 24 (icon 16) after a 4 margin, the line is 1×16, the circle's box is 32 (cell 24 with 4 either side). The
         hover background of every cell is a 24 circle. No task cells → only the circle, and no line -->
    <Grid x:Name="SmallPill" Grid.Column="2" Height="32">
        <ui:SmoothBorder x:Name="SmallSurface" EdgeWidth="1" Radius="16" IsHitTestVisible="False" />
        <Grid x:Name="SmallRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- the cells are built in code (one per card behind the big pill, then ⋯) -->
            <StackPanel x:Name="TaskCells" Orientation="Horizontal" Margin="4,0,0,0" />
            <Rectangle x:Name="SmallRule" Grid.Column="1" Width="1" Height="16" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Grid x:Name="BallBox" Grid.Column="2" Width="32" Height="32">
                <Grid x:Name="BallCell" Width="24" Height="24" Background="Transparent">
                    <Ellipse x:Name="BallHover" Width="24" Height="24" Opacity="0" IsHitTestVisible="False" />
                    <!-- the mark at rest: an empty ring, 8.4 across, 1.2 thick -->
                    <Ellipse x:Name="BallRing" Width="8.4" Height="8.4" StrokeThickness="1.2" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Grid>

    <!-- The swap animation (E4) flies its pieces here, over both pills; the window isn't clipped while they fly -->
    <Canvas x:Name="FlyLayer" IsHitTestVisible="False" />
    </Grid>
</Window>
